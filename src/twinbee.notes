L 0x453F suma_al_segundo
L 0x45AD escribe_los_marcadores
L 0x45CA escribe_la_fase
L 0x45D2 escribe_las_vidas
L 0x45E3 escribe_una_cifra
L 0x45E5 escribe_cifras
C 0x4535 lo que se suma, que viene en BC
C 0x4537 la puntuacion del primero
C 0x453A y su escalon de vida extra
C 0x4541 la del segundo
C 0x4547 el bit 6 de los bits de modo
C 0x454B con el a cero no se puntua: es la demostracion
C 0x454C las dos cifras bajas
C 0x454E en decimal
C 0x4551 las de en medio
C 0x4557 y las altas
C 0x455D si se pasa de 999999
C 0x455F se clava ahi
C 0x4569 el escalon de la vida extra
C 0x4570 hasta llegar a el no hay nada
C 0x4574 y al pasarlo, el escalon sube 0x1000
C 0x4583 y al desbordar se pone en 0xA0
C 0x4588 las vidas
C 0x4589 con 99 ya no caben mas
C 0x458D una mas
C 0x4591 y suena el aviso
C 0x4595 cuatro cifras del record
C 0x459B se compara con la puntuacion
C 0x459F si el record gana, nada
C 0x45A4 y si no, la puntuacion pasa a ser el record
C 0x45AD el marcador del primer jugador
C 0x45B0 en su sitio del buffer
C 0x45B6 y si juegan dos
C 0x45B9 tambien el del segundo
C 0x45C1 y el record, que siempre se pinta
C 0x45CA la fase
C 0x45D2 las vidas del segundo
C 0x45DE y las del primero
